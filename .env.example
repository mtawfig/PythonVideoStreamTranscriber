# AssemblyAI API Key for Speech-to-Text transcription
# Get your API key from: https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# YouTube Cookies - Choose ONE option:

# Option 1: Cookie file (manual export)
# YOUTUBE_COOKIES_FILE=youtube_cookies.txt

# Option 2: Browser cookies (automatic, more reliable)
# Supported: chrome, firefox, edge, safari, opera, brave, chromium
# YOUTUBE_COOKIES_FROM_BROWSER=chrome

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1

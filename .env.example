# AssemblyAI API Key for Speech-to-Text transcription
# Get your API key from: https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# YouTube Cookies File (optional, for restricted videos)
# Leave commented out if not using cookies
# YOUTUBE_COOKIES_FILE=youtube_cookies.txt

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1
